{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM). It lives
 ;; in the kotoba-lang org of this workspace (transferred + renamed from
 ;; com-junkawasaki/langgraph-clj / com-junkawasaki/langchain-clj). This
 ;; repo is standalone (forkable outside the workspace); the :local/root
 ;; paths only resolve inside the monorepo checkout — a standalone fork
 ;; should override them with git coordinates.
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/langgraph"}
        io.github.kotoba-lang/robotics
        {:local/root "../../kotoba-lang/robotics"}
        ;; REAL rigid-body solver for chemmineops.simphysics (bench-face rockfall).
        ;; Pinned git coordinate (:git/sha -- the only key kbb resolves), the same
        ;; fleet-standard commit the sibling quarry actor isic-0810 uses.
        io.github.kotoba-lang/physics-2d
        {:git/url "https://github.com/kotoba-lang/physics-2d.git"
         :git/sha "03b6c23c8d9aa36b92a8130fd3e37fc2548b4d26"}
        ;; shared langchain.db store seam (EDN-blob codec + identity
        ;; schema + event-log read/append helpers) that ~190
        ;; cloud-itonami actors used to hand-roll (ADR-2607141600);
        ;; chemmineops.store's DatomicStore uses it instead of its own
        ;; enc/dec* two-liner.
        io.github.kotoba-lang/langchain-store
        {:local/root "../../kotoba-lang/langchain-store"}}
 :aliases
 {;; offline workspace dev -- pin transitive langchain to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}}}
  ;; kbb -M:dev:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "chemmineops.sim"]}
  ;; kbb -M:dev:physics -> the physical-AI bot's measurement (hermes/profiles/physai-isic-0891/SOUL.md):
  ;; one EDN map of the quantities the REAL physics-2d simulation computed. Exit 2 = could not measure.
  :physics {:main-opts ["-m" "chemmineops.physics-probe"]}
  ;; kbb -M:dev:render-html  -> real actor stack -> operator-console.html
  :render-html {:main-opts ["-m" "chemmineops.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
